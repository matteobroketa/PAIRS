[{"antibody":{"id":"ab_e1bce31a96e296f22c7f","name":"WQB28020_WQB28011","aliases":["Gipg013"],"organism":"Unknown.","format":"paired antibody","has_heavy":true,"has_light":true,"heavy_length":119,"light_length":110,"structures":[],"structure_tiers":{},"exact_structures":[],"homologous_structures":[],"therapeutic_status":"","sequence_quality":{"pairing":"paired","heavy_length":119,"light_length":110,"explicit_vhh":false,"ambiguous_residues":[],"source_format_quarantined":false,"completeness":"unknown_not_inferred","source_nucleotide_available":false},"shard":"e1"},"relationships":["neutralizes"],"evidence":["CURATED"],"sources":["iedb"],"interactions":[{"antibody_id":"ab_e1bce31a96e296f22c7f","target_raw":"Gastric inhibitory polypeptide receptor","relationship":"neutralizes","evidence":"CURATED","source":"iedb","source_record_id":"459","reference":"http://www.iedb.org/reference/1026308","epitope":"A32, G33, Y36, Q37, W39, E40, R43, Q47, F65, M67, Y68, Y87, P89, W90, R113, H115, E119","assay":"biological activity · neutralization","note":"The epitope-specific antibody Gipg013 inhibits the function of the human GIP receptor. Inhibition was demonstrated by Gipg013 antagonism of GIP-stimulated cAMP production in GIPr-overexpressing HEK293 cells; IC50 = 6 nM. The IC50 = 102 nM for Gipg013 Fab and IC50 = 233 nM for the original scFv. Gipg013 IgG was shown to have an IC50 of 17.2 nM for displacement of GIP from GIPr-overexpressing cells.","assertion_origin":"source","source_url":"https://www.iedb.org/database_export_v3.php","record_url":"http://www.iedb.org/assay/2019185","link_scope":"record","measurements":[],"target_external_id":"http://www.uniprot.org/uniprot/P48546","assay_ids":["2019185"],"receptor_group_id":"459","id":"ix_54a71925ddb3de96e18a","target_id":"target:gastric-inhibitory-polypeptide-receptor-65a48a53fdc3","target_name":"Gastric inhibitory polypeptide receptor"},{"antibody_id":"ab_e1bce31a96e296f22c7f","target_raw":"Gastric inhibitory polypeptide receptor",