[{"antibody":{"id":"ab_fa3a19ff50fe0d925085","name":"4J21","aliases":[],"organism":"","format":"IEDB heavylight","has_heavy":true,"has_light":true,"heavy_length":127,"light_length":111,"structures":[],"structure_tiers":{},"exact_structures":[],"homologous_structures":[],"therapeutic_status":"","sequence_quality":{"pairing":"paired","heavy_length":127,"light_length":111,"explicit_vhh":false,"ambiguous_residues":[],"source_format_quarantined":false,"completeness":"unknown_not_inferred","source_nucleotide_available":false},"shard":"fa"},"relationships":["binds"],"evidence":["CURATED"],"sources":["iedb"],"interactions":[{"antibody_id":"ab_fa3a19ff50fe0d925085","target_raw":"Frameshifted structural polyprotein","relationship":"binds","evidence":"CURATED","source":"iedb","source_record_id":"761","reference":"http://www.iedb.org/reference/1029588","epitope":"N7, V8, K10, A11, D59, D60, H62, E166, V169, M171, G194, T212, H232, K234, W235, R251, K252, G253, K254, I255","assay":"electron microscopy · 3D structure","note":"The epitope of 4J21 Fab on Chikungunya virus E2 protein was determined from the cryo-EM structure of CHIKV VLPs in complex with the Fab fragment. There was one Fab fragment bound to each E1–E2 heterodimer. The footprint of 4J21 Fab on the virus surface was defined by the atoms in the virus that were closer than 4 Å from any atom in the bound Fab molecule. Fab 4J21 bound primarily to the E2 βr-ribbon connector. The contact surface area is 944 Å^2 for the 4J21 Fab fragment.","assertion_origin":"source","source_url":"https://www.iedb.org/database_export_v3.php","record_url":"http://www.iedb.org/assay/2546041","link_scope":"record","measurements":[],"target_external_id":"http://www.uniprot.org/uniprot/P0DOK1","assay_ids":["2546041"],"receptor_group_id":"761","id":"ix_91940657d1c8eb46db3c","target_id":"target:frameshifted-structural-polyprotein-68badd59e658","target_name":"Frameshifted structural polyprotein"},{"antibody_id":"ab_fa3a19ff50fe0d925085","target_raw":"Frameshifted structural polyprotein","relationship":"binds","evidence":"CURATED","source":"iedb","source_record_id":"761","reference":"http://www.iedb.org/reference/1029588","epitope":"N7, V8, K10, A11, D59, D60, H62, E166, V169, M171, G194, T212, H232, K234, W235, R251, K252, G253, K254, I255","assay":"flow cytometry · qualitative binding","note":"The most important residues on E2 within the epitope-specific 4J21 Fab binding footprint, were determined by loss of antibody reactivity to 910 CHIKV E1-E2 alanine mutations throughout this glycoprotein. Immune reactivity was assessed using high-throughput flow cytometry. The residues that resulted in >50% loss of Fab reactivity are consistent with the cryo-EM results. For the most important residues of the epitope, single mutation of V169A, K234A, or I255A on the E2 β-ribbon connector resulted in complete loss of binding reactivity of mAb 4J21.","assertion_origin":"source","source_url":"https://www.iedb.org/database_export_v3.php","record_url":"http://www.iedb.org/assay/2546048","link_scope":"record","measurements":[],"target_external_id":"http://www.uniprot.org/uniprot/P0DOK1","assay_ids":["2546048"],"receptor_group_id":"761","id":"ix_b492d5041f19bf805665","target_id":"target:frameshifted-structural-polyprotein-68badd59e658","target_name":"Frameshifted structural polyprotein"}]},{"antibody":{"id":"ab_a868254104f35af84d0a","name":"5ANY_J_N","aliases":["5ANY_I_M","5ANY_K_O","5ANY_L_P","8DWY_H_L","8DWY_V_U","8DWY_X_W"],"organism":"Mus musculus","format":"paired antibody","has_heavy":true,"has_light":true,"heavy_length":117,"light_length":109,"structures":[],"structure_tiers":{},"exact_structures":[],"homologous_structures":[],"therapeutic_status":"","sequence_quality":{"pairing":"paired","heavy_length":117,"light_length":109,"explicit_vhh":false,"ambiguous_residues":[],"source_format_quarantined":false,"completeness":"unknown_not_inferred","source_nucleotide_available":false},"shard":"a8"},"relationships":["binds"],"evidence":["CURATED"],"sources":["iedb"],"interactions":[{"antibody_id":"ab_a868254104f35af84d0a","target_raw":"Frameshifted structural polyprotein","relationship":"binds","evidence":"CURATED","source":"iedb","source_record_id":"766","reference":"http://www.iedb.org/reference/1029622","epitope":"Q115, S116, I121, V128, Y130, G140, L141, I148","assay":"ELISA · qualitative binding","note":"The epitiope residues critical for binding of CHK-265 mAb were mapped by alanine-scanning and single amino acid mutagenesis and mammalian cell display of the E2, 6K, and E1 proteins. The neutralizing CHK-265 mAb bound primarily to sites within the B domain of the E2 protein. Analysis of CHIKV E2 ectodomain with amino acid substitutions corroborated the alanine-scanning mapping results.","assertion_origin":"source","source_url":"https://www.iedb.org/database_export_v3.php","record_url":"http://www.iedb.org/assay/2546183","link_scope":"record","measurements":[],"target_external_id":"http://www.uniprot.org/uniprot/P0DOK1","assay_ids":["2546183"],"receptor_group_id":"766","id":"ix_a5d2652bb18feb20ea7c","target_id":"target:frameshifted-structural-polyprotein-68badd59e658","target_name":"Frameshifted structural polyprotein"},{"antibody_id":"ab_a868254104f35af84d0a","target_raw":"Frameshifted structural polyprotein","relationship":"binds","evidence":"CURATED","source":"iedb","source_record_id":"766","reference":"http://www.iedb.org/reference/1029622","epitope":"Q115, S116, I121, V128, Y130, G140, L141, I148","assay":"electron microscopy · 3D structure","note":"The structure of CHIKV virions in complex with CHK-265 Fab fragments was determined by cryo-electron microscopy at about 16Å resolution. Three Fab molecules were bound to each of the q3 and i3 trimeric spikes within the 60 icosahedral asymmetric units. Fitting the CHK-265 Fab density into the cryo-EM reconstruction showed that CHK-265 Fab binds the B domain on one spike and contacts the A domain on a neighboring spike, effectively cross-